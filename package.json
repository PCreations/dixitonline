{
  "name": "tixid-online",
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "license": "MIT",
  "description": "Tixid is an online version of the Dixit card game.",
  "repository": {
    "type": "git",
    "url": "https://github.com/PCreations/dixitonline.git"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "wallaby": {
    "runMode": "save"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -b tsconfig.build.json",
    "check": "tsc -b tsconfig.json",
    "lint": "biome check src/",
    "lint-fix": "biome check --write src/",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "clean": "rm -rf dist build .tsbuildinfo"
  },
  "dependencies": {
    "effect": "latest",
    "fastify": "^5.5.0",
    "fastify-type-provider-effect-schema": "^0.0.4",
    "preact": "^10.27.1",
    "preact-render-to-string": "^6.6.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.8",
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.24.7",
    "@babel/plugin-transform-modules-commonjs": "^7.24.8",
    "@biomejs/biome": "2.1.2",
    "@effect/build-utils": "^0.7.7",
    "@effect/eslint-plugin": "^0.2.0",
    "@effect/language-service": "^0.1.0",
    "@effect/vitest": "^0.22.5",
    "@eslint/compat": "1.1.1",
    "@eslint/eslintrc": "3.1.0",
    "@eslint/js": "9.10.0",
    "@types/node": "^22.5.2",
    "@types/pino": "^7.0.5",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "babel-plugin-annotate-pure-calls": "^0.4.0",
    "eslint": "^9.10.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-codegen": "^0.28.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "pino-pretty": "^13.1.1",
    "supabase": "^2.34.3",
    "tsx": "^4.17.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9",
    "xstate": "^5.21.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "babel-plugin-annotate-pure-calls@0.4.0": "patches/babel-plugin-annotate-pure-calls@0.4.0.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase",
      "unrs-resolver"
    ]
  }
}
