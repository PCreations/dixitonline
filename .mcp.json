{
  "mcpServers": {
    "wallaby": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "-c",
        "node ~/.wallaby/mcp"
      ],
      "env": {}
    },
    "console-ninja": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "-c",
        "node ~/.console-ninja/mcp"
      ],
      "env": {}
    },
    "supabase": {
      "type": "http",
      "url": "http://127.0.0.1:44321/mcp?read_only=true"
    }
  }
}